# Copy to .env and fill in. Never commit .env.

# --- language model (small model or any OpenAI-compatible endpoint) ---
# The API key is REQUIRED. llm-proxy.js (and later the real server) refuse to start without it.
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=20000
LLM_MAX_TOKENS=400
LLM_MAX_CONCURRENT=2

# --- llm-proxy.js ---
PORT=8787
ALLOW_ORIGIN=http://localhost:5177

# --- real server (apps/server) ---
# DATABASE_URL=postgres://user:pass@localhost:5432/hisaab
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# SENTRY_DSN=
